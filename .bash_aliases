# aliases
alias ll='ls -alF'
alias la='ls -A'
alias c="clear"
alias maj="yay -Suy"
alias ..='cd .. && pwd'
alias ...='cd .. && cd .. && pwd'
alias ....='cd .. && cd .. && cd .. && pwd'
alias n='nvim'

# scrips
alias nobsi="cd ~/Documents/myobsi && nvim"
alias nconfig="cd ~/.config/nvim/lua && nvim"
